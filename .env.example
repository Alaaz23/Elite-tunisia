# Local development examples only. Never reuse these values in production.
POSTGRES_DB=elite_tunisia
POSTGRES_USER=elite
POSTGRES_PASSWORD=<SET_STRONG_PASSWORD>

DATABASE_URL=jdbc:postgresql://localhost:5432/elite_tunisia
DATABASE_USERNAME=elite
DATABASE_PASSWORD=<SET_STRONG_PASSWORD>

# Generate a unique secret of at least 32 bytes before starting Spring Boot.
JWT_SECRET=<SET_RANDOM_SECRET_OF_32_BYTES_OR_MORE>
SECURE_COOKIES=false
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200